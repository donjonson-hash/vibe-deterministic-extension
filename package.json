{
  "name": "vibe-deterministic-extension",
  "displayName": "Vibe Deterministic Coder",
  "description": "Deterministic guardrails & flow-state extension for vibe coders",
  "version": "0.1.0",
  "publisher": "donjonson-hash",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/donjonson-hash/vibe-deterministic-extension.git"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": "^22.18.0 || >=24.11.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onCommand:vibe.executeIntent",
    "onCommand:vibe.rollbackLast"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vibe.executeIntent",
        "title": "Execute Vibe Intent (Deterministic Pipeline)",
        "category": "Vibe"
      },
      {
        "command": "vibe.rollbackLast",
        "title": "TimeMachine: Rollback Last Vibe",
        "category": "Vibe"
      }
    ],
    "keybindings": [
      {
        "command": "vibe.executeIntent",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "editorTextFocus"
      },
      {
        "command": "vibe.rollbackLast",
        "key": "ctrl+alt+z",
        "mac": "cmd+alt+z",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "build": "tsc -p ./ && node scripts/copy-vendor.mjs dist",
    "test": "tsc -p tsconfig.test.json && node scripts/copy-vendor.mjs dist-tests/src && node --test dist-tests/tests/unit/*.test.js",
    "spike:build": "tsc -p tsconfig.spike.json && node scripts/copy-vendor.mjs dist-spike/src",
    "build:chrome": "node scripts/build-chrome.mjs",
    "test:chrome": "node scripts/check-chrome.mjs",
    "test:evidence": "node --test tests/drydock.test.mjs",
    "package:chrome": "npm run build:chrome && python3 scripts/package-chrome.py"
  },
  "dependencies": {
    "@babel/parser": "8.0.7",
    "typescript": "^5.4.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.132.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "0.28.2",
    "playwright": "1.58.2"
  }
}
